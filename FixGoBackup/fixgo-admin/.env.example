# Sao chép thành .env.local (chạy local) hoặc khai báo trong Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...) hoặc anon key cũ — KHÔNG dùng secret/service_role key ở đây
NEXT_PUBLIC_SUPABASE_KEY=
# Mapbox PUBLIC token (pk.…) để hiển thị hành trình đơn
NEXT_PUBLIC_MAPBOX_TOKEN=
