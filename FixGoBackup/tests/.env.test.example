# Sao chép thành tests/.env.test — dùng một dự án Supabase DÙNG THỬ (không phải dự án thật!).
SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
# Publishable key (hoặc anon key)
SUPABASE_KEY=
# Secret key (sb_secret_...) hoặc service_role key – CHỈ dùng cho kiểm thử, không đưa vào app
SUPABASE_SERVICE_KEY=
# Đặt TEST_EDGE=1 nếu đã deploy Edge Function create-request (kiểm thử phân phối theo tuyến Mapbox)
TEST_EDGE=0
